{
  "name": "pdftranslate",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "AI-powered PDF translator with layout preservation. Local-first, GitHub Pages hostable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "dev:desktop": "vite --mode desktop",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "tauri": "tauri",
    "prep:desktop": "node scripts/fetch-uv.mjs && node scripts/stage-backend.mjs",
    "desktop": "npm run prep:desktop && tauri dev",
    "desktop:build": "npm run prep:desktop && tauri build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "franc-min": "^6.2.0",
    "lucide-react": "^0.474.0",
    "motion": "^11.18.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
