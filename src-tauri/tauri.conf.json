{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFTranslate",
  "version": "0.1.1",
  "identifier": "top.rayleigh-lin.pdftranslate",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDFTranslate",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DragonLYL0718/PDFTranslate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwODFGMzExNUNEREFFODYKUldTR3J0MWNFZk9CSUpwUTZQWkR2N3ZSNzU2MFVYVzBPNjZwdE5sK3NkTXlCR2M1Uys0TmMrN1EK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/uv"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF",
        "description": "PDF document",
        "role": "Viewer"
      }
    ],
    "resources": {
      "resources/backend": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
