{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-file",
      "comment": "Exports only, and always to a path the user just picked in the save dialog. Scoped to the user's own tree rather than the whole filesystem.",
      "allow": [
        { "path": "$HOME/*" },
        { "path": "$HOME/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" }
      ]
    },
    {
      "identifier": "http:default",
      "comment": "AI providers are user-configured, so the host can't be known ahead of time. This is the permission that replaces the CORS relay.",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
